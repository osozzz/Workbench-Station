{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench Station",
  "version": "3.0.0",
  "identifier": "com.osozzz.workbenchstation",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Workbench Station",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0b1c19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alejandro Osorno",
    "copyright": "Copyright (c) 2026 Alejandro Osorno",
    "category": "DeveloperTool",
    "shortDescription": "Keeps the apps and tools on this PC up to date",
    "longDescription": "Workbench Station audits this PC, shows which apps and developer tools can be updated and how risky each update is, and installs only the updates you confirm.",
    "homepage": "https://github.com/osozzz/Workbench-Station",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../../scripts/": "workstation/scripts/",
      "../../VERSION": "workstation/VERSION",
      "../../config/workstation.policy.json": "workstation/config/workstation.policy.json"
    }
  }
}
